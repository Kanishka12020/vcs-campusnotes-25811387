#!/bin/sh
files=$(git diff --cached --name-only --diff-filter=ACM)
status=0

for f in $files; do
    case "$f" in .githooks/*) continue ;; esac
    if git show ":$f" | grep -nE "TODO|FIXME" >/dev/null 2>&1; then
        echo "pre-commit: BLOCKED - '$f' contains TODO or FIXME"
        status=1
    fi
done

exit $status
