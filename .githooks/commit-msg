#!/bin/sh
msg=$(head -n1 "$1")

if [ ${#msg} -lt 10 ]; then
    echo "commit-msg: BLOCKED - message shorter than 10 characters"
    exit 1
fi

case "$msg" in
    feat:*|fix:*|docs:*|refactor:*|chore:*)
        exit 0
        ;;
    *)
        echo "commit-msg: BLOCKED - invalid prefix"
        echo "Use feat:, fix:, docs:, refactor: or chore:"
        exit 1
        ;;
esac
